[Unit]
Description=Solo Empire local Codex quota collector

[Service]
# Replace /opt/solo-ai-usage with the path of this repository checkout.
Type=simple
WorkingDirectory=/opt/solo-ai-usage
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/solo-ai-usage/collector.py codex --interval 300
Restart=on-failure
RestartSec=30
UMask=0077

[Install]
WantedBy=default.target
