[Unit]
Description=Solo Empire local AI usage dashboard API

[Service]
# Replace /opt/solo-ai-usage with the path of this repository checkout.
Type=simple
WorkingDirectory=/opt/solo-ai-usage
Environment=PYTHONPATH=/opt/solo-ai-usage/vendor/service-auth
ExecStart=/usr/bin/python3 /opt/solo-ai-usage/server.py --host 127.0.0.1 --port 3520
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
